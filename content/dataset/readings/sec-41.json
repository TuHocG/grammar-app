[{"id":2510,"title":"Ngu Phap","en":[],"vi":[],"img":"img/readings/3.webp"},{"id":2511,"title":"Bai 1","en":[["THE BODY"],["Parts of the body"],["- head"],["- shoulder"],["- arm"],["- hand"],["- finger"],["- chest"],["- leg"],["- foot"],["- toe"],["- What is that?","That is his head."],["- What are those?","Those are his shoulders."],["- What is this?","This is his chest."],["- What are these?","These are his feet."],["- He is tall."],["- She is short."],["- She is thin."],["- He is fat."],["- He is heavy."],["- She is light."]],"vi":[["Cơ thể"],["Các bộ phận của cơ thể"],["đầu"],["vai"],["cánh tay"],["bàn tay"],["ngón tay"],["ngực"],["chân"],["bàn chân"],["ngón chân"],["Kia là gì?","Ðó là cái đầu của anh ấy."],["Kia là những gì?","Ðó là hai vai của anh ấy."],["Ðây là gì?","Ðây là ngực của anh ấy."],["Ðây là những gì?","Ðây là chân của anh ấy. (chú ý: feet số nhiều không có s)"],["Anh ấy cao"],["Bà ấy thấp."],["Cô ấy gầy."],["Anh ấy mập."],["ông ấy nặng"],["Cô ấy nhẹ."]],"img":"img/readings/1.6.96a.webp","page":"96"},{"id":2512,"title":"Bai 2","en":[["4. Which picture?","Listen and choose the right picture."],["- She's a short girl.","She's fat."],["- He's a fat man.","He's tall."],["- He's a short man.","He's fat."],["- She's a thin woman.","She's tall."],["5. Listen and read."],["a) Chi is a gymnast."],["- She is tall."],["- She is thin."],["- She is light."],["- But she is not weak."],["- She is strong."],["b) Tuan is a weight lifter."],["- He is short."],["- He is fat."],["- He is heavy."],["- He is strong."]],"vi":[["Tranh nào?","Nghe và chọn tranh đúng."],["Cô ấy là một cô gái thấp người.","Cô ấy mập."],["Anh ấy là một người mập.","Anh ấy cao."],["ông ấy là một người thấp.","ông ấy mập."],["Bà ấy là một người đàn bà gầy.","Bà ấy cao."],["Nghe và đọc"],["Chi là một vận động viên thể dục."],["Cô ấy cao."],["Cô ấy gầy."],["Cô ấy nhẹ."],["Nhưng cô ấy không yếu."],["Cô ấy khỏe."],["Tuấn là một vận động viên cử tạ."],["Anh ấy thấp."],["Anh ấy mập."],["Anh ấy nặng."],["Anh ấy khỏe."]],"img":"img/readings/1.6.98a.webp","page":"98"},{"id":2513,"title":"Bai 3","en":[["6. Practice with a partner."],["Describe the pictures in exercise A5."],["- Who is that?"],["- That's Chi."],["- What does she do?"],["- She is a gymnast."],["- Is she short?"],["- No, she isn't.","She's tall."],["- Is she thin?","Yes, she is."],["- Is she heavy?","No, she isn't.","She is light."],["- Is she weak or strong?","She's strong."],["- Who is that?","That's Tuan."],["- What does he do?","He's a weight lifter."],["- Is he short?","Yes, he is."],["- Is he thin?","No, he isn't.","He's fat."],["- Is he heavy or light?","He's heavy."],["- Is he strong?","Yes, he is.","He's very strong."]],"vi":[["Thực hành với một bạn"],["Mô tả các bức tranh trong bài tập A5."],["Kia là ai?"],["Ðó là Chi."],["Cô ấy làm gì?"],["Cô ấy là một vận động viên thể dục."],["Có phải cô ấy thấp không?"],["Không, không phải.","Cô ấy cao."],["Có phải cô ấy gầy không?","Vâng, phải."],["Có phải cô ấy nặng không?","Không, không phải.","Cô ấy nhẹ."],["Cô ấy yếu hay khỏe?","Cô ấy khỏe."],["Kia là ai?","Ðó là anh Tuấn."],["Anh ấy làm gì?","Anh ấy là vận động viên cử tạ."],["Có phải anh ấy thấp không?","Vâng phải."],["Có phải anh ấy gầy không?","Không, không phải.","Anh ấy mập."],["Anh ấy nhẹ hay nặng?","Anh ấy nặng."],["Anh ấy khỏe không?","Vâng phải","Anh ấy rất khỏe."]],"img":"img/readings/1.6.99a.webp","page":"99"},{"id":2514,"title":"Bai 4","en":[["Face"],["1. Listen and repeat."],["- Hair","That is his hair."],["- Eye","These are his eyes."],["- Nose","This is his nose."],["- Mouth.","That is his mouth."],["- Ear","Those are his ears."],["- Lips.","Those are his lips."],["- Teeth.","Those are his teeth."],["- a round face.","He has a round face."],["- an oval face.","She has an oval face."],["- full lips.","She has full lips."],["- thin lips.","He has thin lips."],["- long hair.","She has long hair."],["- short hair.","He has short hair."]],"vi":[["Khuôn mặt"],["Nghe và lặp lại"],["Tóc","Ðó là tóc của anh ấy."],["Mắt","Ðây là đôi mắt của anh ấy."],["taiMũi","Ðây là mũi của anh ấy."],["Miệng","Ðó là miệng của anh ấy."],["Tai","Kia là đôi tai của anh ấy."],["Môi","Ðó là đôi môi của anh ấy."],["Răng","Kia là răng của anh ấy."],["Một khuôn mặt tròn.","Anh ấy có một khuôn mặt tròn."],["Một khuôn mặt trái xoan.","Cô ấy có một khuôn mặt trái xoan."],["Ðôi môi đầy đặn","Cô ấy có một đôi môi đầy đặn"],["đôi môi mỏng","Anh ấy có đôi môi mỏng."],["tóc dài","Cô ấy có tóc dài."],["tóc ngắn","Anh ấy có tóc ngắn."]],"img":"img/readings/1.6.100a.webp","page":"100"},{"id":2515,"title":"Ngu Phap","en":[],"vi":[],"img":"img/readings/3.webp"},{"id":2516,"title":"Bai 5","en":[["2. Listen and repeat.","Colors"],["- black"],["- white"],["- gray"],["- red"],["- orange"],["- yellow"],["- green"],["- blue"],["- brown"],["- purple"],["3. Practice with a partner."],["- What color is her hair?"],["- It's black."],["- What color are her eyes?"],["- They're brown."],["- What color is her dress?"],["- It's yellow, green, red and white."],["- What color are her shoes?"],["- They are green."]],"vi":[["Nghe và lặp lại","Màu sắc"],["màu đen"],["màu trắng"],["màu xám"],["màu đỏ"],["màu cam"],["màu vàng"],["màu xanh lá cây"],["màu xanh da trời"],["màu nâu"],["màu tía"],["Thực hành với một bạn"],["Tóc cô ấy màu gì?"],["Màu đen"],["Mắt cô ấy màu gì?"],["Màu nâu"],["áo đầm của cô ấy màu gì?"],["Màu vàng, xanh, đỏ và trắng."],["Giày của cô ấy màu gì?"],["Màu xanh lá cây."]],"img":"img/readings/1.6.101a.webp","page":"101"},{"id":2517,"title":"Bai 6","en":[["4. Listen and read"],["- Miss Chi is tall and thin."],["- She has a round face."],["- She has long black hair."],["- She has brown eyes."],["- She has a small nose."],["- She has full lips and small white teeth."]],"vi":[["Nghe và đọc"],["Cô Chi cao và mảnh khảnh."],["Cô có khuôn mặt tròn."],["Cô có mái tóc đen, dài."],["Cô có đôi mắt nâu."],["Cô có cái mũi nhỏ."],["Cô có đôi môi đầy đặn và hàm răng trắng nhỏ."]],"img":"img/readings/1.6.101b.webp","page":"101"},{"id":2518,"title":"Bai 7","en":[["Now, ask and answer questions about Chi."],["- Is Miss Chi's face oval or round?","It's round."],["a) Is Miss Chi's hair long or short?","It's long."],["b) What color is her hair?","It's black."],["c) What color are her eyes?","They're brown."],["d) Is her nose big or small?","It's small."],["e) Are her lips full or thin?","They're full."]],"vi":[["Bây giờ hãy hỏi và trả lời những câu hỏi về Chi."],["Khuôn mặt cô Chi hình trái xoan hay tròn?","Mặt tròn"],["Tóc cô Chi dài hay ngắn?","Tóc dài"],["Tóc cô ấy màu gì?","Màu đen"],["Mắt cô ấy màu gì?","Màu nâu"],["Mũi cô ấy to hay nhỏ?","Nhỏ"],["Môi cô ấy đầy đặn hay mỏng?","đầy đặn"]],"img":"img/readings/1.6.102a.webp","page":"102"},{"id":2519,"title":"Bai 8","en":[["Write the letters of the pictures in your exercise book."],["a) He has short hair.","He has a round face.","He has a big nose.","He has full lips."],["b) She has long hair.","She has an oval face.","She has a big nose.","She has thin lips."],["c) He has short hair.","He has an oval face.","He has a small nose.","He has thin lips."],["d) She has long hair.","She has a round face.","She has a small nose.","She has full lips."],["6. Play with words."],["- Head and shoulders,"],["- Knees and toes."],["- Knees and toes."],["- Head and shoulders,"],["- Knees and toes."],["- Knees and toes."],["- Ears and eyes"],["- And mouth and nose."],["- Head and shoulders,"],["- Knees and toes."],["- Knees and toes."]],"vi":[["Viết các mẫu tự của các bức tranh ứng với từng câu vào vở bài tập của bạn."],["Anh ấy có mái tóc ngắn.","Anh ấy có khuôn mặt tròn.","Anh ấy có cái mũi to.","Anh ấy có môi đầy đặn."],["Cô ấy có mái tóc dài.","Cô ấy có khuôn mặt trái xoan.","Cô ấy có cái mũi to.","Cô ấy có làn môi mỏng."],["Anh ấy có mái tóc ngắn.","Anh ấy có khuôn mặt trái xoan.","Anh ấy có cái mũi nhỏ.","Anh ấy có môi mỏng."],["Cô ấy có mái tóc dài.","Cô ấy có khuôn mặt tròn.","Cô ấy có cái mũi nhỏ.","Cô ấy có làn môi đầy đặn."],["Luyện tập từ"],["Ðầu và hai vai."],["Hai đầu gối và các ngón chân."],["Hai đầu gối và các ngón chân."],["Ðầu và hai vai."],["Hai đầu gối và các ngón chân."],["Hai đầu gối và các ngón chân."],["đôi tai và cặp mắt"],["Cùng miệng và mũi"],["Ðầu và hai vai."],["Hai đầu gối và các ngón chân."],["Hai đầu gối và các ngón chân."]],"img":"img/readings/1.6.102b.webp","page":"102"}]