<?xml version="1.0" encoding="utf-8"?>
<!-- Android ≤ 11 Auto Backup: user.db is worth backing up, the downloaded lesson data (hundreds of MB,
     over the backup quota, and downloadable again) is not. -->
<full-backup-content>
    <exclude domain="file" path="content"/>
    <exclude domain="file" path="audio"/>
    <exclude domain="file" path="video"/>
</full-backup-content>
