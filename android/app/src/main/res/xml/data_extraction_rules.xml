<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same as backup_rules.xml, for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="content"/>
        <exclude domain="file" path="audio"/>
        <exclude domain="file" path="video"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="content"/>
        <exclude domain="file" path="audio"/>
        <exclude domain="file" path="video"/>
    </device-transfer>
</data-extraction-rules>
